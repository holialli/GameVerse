# Frontend Firebase Configuration
# IMPORTANT: Never hardcode these values in source code
# Always load from environment variables or .env files (which are gitignored)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_GOOGLE_AI_API_KEY=

# Backend Configuration  
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/gameverse
PORT=4000

# Email Service (Resend)
RESEND_API_KEY=

# Google AI (Gemini)
GOOGLE_AI_API_KEY=

# AWS Configuration (for production secrets)
USE_AWS_SECRETS=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Redis (optional)
REDIS_URL=

# Other services
RAWG_API_KEY=
CHEAPSHARK_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
