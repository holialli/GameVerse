FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
# npm is only needed for this install; the server starts with plain `node`.
# Removing it drops the npm bundled in the base image, whose own dependencies
# (e.g. node-tar CVE-2026-59873, CRITICAL) fail the pipeline's Trivy gate.
RUN npm install \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx /root/.npm
COPY . .
EXPOSE 5000
CMD ["node", "server.js"]